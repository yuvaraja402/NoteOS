# Copy to `.env` for local Docker Compose only.
# Do not commit `.env`.

NOTEOS_ENV=local
AWS_REGION=ca-central-1

# Local Postgres values. Use a unique local password.
POSTGRES_DB=noteos
POSTGRES_USER=noteos
POSTGRES_PASSWORD=replace-with-local-only-password

# Local service wiring.
CORS_ORIGINS=http://localhost:3050
API_INTERNAL_URL=http://api:8000
NOTEOS_DATABASE_URL=postgresql+psycopg2://noteos:replace-with-local-only-password@db:5432/noteos

# Production/staging should use SSM instead of a raw database URL.
NOTEOS_DATABASE_URL_SSM_PARAM=
