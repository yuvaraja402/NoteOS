# Optional Compose configuration; no secret values belong here.
# Frontend-only Compose works without copying this file.
API_INTERNAL_URL=http://api:8000
AWS_REGION=ca-central-1
AWS_PROFILE=default
CORS_ORIGINS=http://localhost:3050

# Enable the 'cloud' profile only with real AWS resources and private VPC access.
DYNAMODB_TABLE_NAME=noteos-production-notes
REDIS_HOST=
REDIS_AUTH_TOKEN_SSM_PARAM=/noteos/production/redis/auth-token
SESSION_SIGNING_KEY_SSM_PARAM=/noteos/production/session/signing-key
FLUSH_IDLE_SECONDS=60
FLUSH_MAX_SECONDS=300
