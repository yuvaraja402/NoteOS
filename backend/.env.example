# AWS-backed API only. There is no local database or cache fallback.
# Keep AWS credentials in your AWS profile, not this file.
NOTEOS_ENV=local
AWS_REGION=ca-central-1
AWS_PROFILE=default
CORS_ORIGINS=http://localhost:3050
DYNAMODB_TABLE_NAME=noteos-production-notes
REDIS_HOST=
REDIS_PORT=6379
REDIS_AUTH_TOKEN_SSM_PARAM=/noteos/production/redis/auth-token
SESSION_SIGNING_KEY_SSM_PARAM=/noteos/production/session/signing-key
FLUSH_IDLE_SECONDS=60
FLUSH_MAX_SECONDS=300
FLUSH_POLL_SECONDS=5
CACHE_TTL_SECONDS=86400
