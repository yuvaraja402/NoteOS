# Copy to `backend/.env` only for direct local API development.
# Do not commit `backend/.env`.

NOTEOS_ENV=local
AWS_REGION=ca-central-1
CORS_ORIGINS=http://localhost:3050

# Local direct-run default. Docker Compose overrides this with the Compose DB host.
NOTEOS_DATABASE_URL=sqlite:///./noteos.db

# Staging/production should set this and leave NOTEOS_DATABASE_URL unset.
NOTEOS_DATABASE_URL_SSM_PARAM=
